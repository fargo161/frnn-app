PORT=3000
NODE_ENV=production
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
PG_POOL_MAX=10
ADMIN_KEY=CHANGE-THIS-TO-A-LONG-RANDOM-SECRET
MISSION_CONTROL_PASSPHRASE=CHANGE-THIS-TO-A-SHARED-TEAM-PASSPHRASE
PUBLIC_BASE_URL=https://signal.your-domain.example
# Set to true only if your provider requires it for managed Postgres SSL.
PGSSL=false

# Cloudflare R2 through the S3-compatible media-storage boundary.
# Never commit live credentials. R2_ENDPOINT normally uses the account-specific
# S3 API endpoint, while R2_PUBLIC_BASE_URL is optional until public delivery is configured.
R2_ACCOUNT_ID=9af5298a5d7746f282305ef4f532af78
R2_BUCKET_NAME=artpark
R2_ACCESS_KEY_ID=REPLACE-WITH-R2-ACCESS-KEY-ID
R2_SECRET_ACCESS_KEY=REPLACE-WITH-R2-SECRET-ACCESS-KEY
R2_ENDPOINT=https://9af5298a5d7746f282305ef4f532af78.r2.cloudflarestorage.com
R2_PUBLIC_BASE_URL=
