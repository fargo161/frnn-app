# Local Web Test Lab settings. Copy this file to .env.test-lab.
# The database URL below matches the repository's local Docker Compose database.
DATABASE_URL=postgres://artpark:artpark@localhost:5432/artpark

# Replace both placeholder values. They are not printed by the Test Lab.
ADMIN_KEY=REPLACE-WITH-A-LONG-LOCAL-MAINTENANCE-KEY
MISSION_CONTROL_PASSPHRASE=CHOOSE-A-LOCAL-TEST-LAB-PASSPHRASE

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
